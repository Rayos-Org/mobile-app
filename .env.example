# ── Guardian Wallet mobile — public runtime config ─────────────────────────
# All values are inlined into the JS bundle at build time (EXPO_PUBLIC_*).
# Nothing here is secret. Secrets for EAS/CI live in GitHub → Settings → Secrets.

# Relay backend (NestJS). Must be reachable from the DEVICE, so never localhost
# for real-device testing — use the deployed URL or a tunnel (ngrok / cloudflared).
EXPO_PUBLIC_RELAY_BACKEND_URL=https://rayos-relay-backend.onrender.com/api

# Must match the relay's WEBAUTHN_RP_ID and the host that serves
# /.well-known/apple-app-site-association + /.well-known/assetlinks.json
EXPO_PUBLIC_WEBAUTHN_RP_ID=rayos-relay-backend.onrender.com

# Stellar testnet
EXPO_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
EXPO_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org
EXPO_PUBLIC_STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
EXPO_PUBLIC_FACTORY_CONTRACT_ID=CCCAMWJOF7IYTVCU7SR6HFTNH5XRMDMWPYN464NY5BCKUPMUM64RZ5CH
EXPO_PUBLIC_POLICY_CONTRACT_ID=CCDM3O2SXX3E24MCWLRK5YBVQHJCA4OQKJFF6KWCK6FHZS65DGMT6DOY

# ── Build-time only (read by app.config.ts, not shipped in the bundle) ──────
# Set by `eas init` (or GitHub secret EAS_PROJECT_ID). Required for `eas build`.
# EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# EXPO_OWNER=rayos-org
# APP_ENV=development            # development | preview | production (eas.json sets this)
# PASSKEY_DOMAIN=rayos-relay-backend.onrender.com
