{
  "name": "@rayos/mobile-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@rayos/wallet-sdk": "file:..\\wallet-sdk",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@tanstack/react-query": "^5.102.8",
    "date-fns": "^4.4.0",
    "expo": "~57.0.22",
    "expo-build-properties": "~57.0.17",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "^57.0.18",
    "expo-crypto": "^57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "^57.0.10",
    "expo-notifications": "^57.0.18",
    "expo-router": "^57.0.21",
    "expo-secure-store": "^57.0.4",
    "expo-splash-screen": "^57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.22",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-passkeys": "^0.4.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "doctor": "npx expo-doctor",
    "export": "expo export --platform web",
    "e2e": "maestro test e2e/flows",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview",
    "build:prod": "eas build --profile production",
    "update:preview": "eas update --channel preview --message",
    "submit:prod": "eas submit --profile production"
  },
  "private": true,
  "description": "Guardian Wallet — passkey-secured Stellar smart wallet for iOS & Android (Expo)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rayos-Org/mobile-app.git"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/"
    ],
    "collectCoverageFrom": [
      "lib/**/*.ts",
      "hooks/**/*.ts",
      "components/**/*.tsx",
      "!**/*.d.ts"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.17.0"
}
