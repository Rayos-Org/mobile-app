{
  "expo": {
    "name": "Rayos",
    "slug": "rayos-wallet",
    "scheme": "rayos",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.rayos.wallet",
      "associatedDomains": [
        "applinks:relay-staging.rayos.dev",
        "webcredentials:relay-staging.rayos.dev"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.rayos.wallet",
      "intentFilters": [{
        "action": "VIEW",
        "autoVerify": true,
        "data": [{ "scheme": "https", "host": "relay-staging.rayos.dev", "pathPrefix": "/recovery" }],
        "category": ["BROWSABLE", "DEFAULT"]
      }]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": []
  }
}
